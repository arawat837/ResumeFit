# Frontend API URL
VITE_API_URL=http://localhost:8000

# Google Cloud OAuth 2.0 Client ID (Web Application)
# 1. Create a project in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Configure OAuth consent screen
# 3. Create Credentials -> OAuth client ID -> Web application
# 4. Add Authorized JavaScript origin: http://localhost:5173
# 5. Paste the Client ID below:
VITE_GOOGLE_CLIENT_ID=
