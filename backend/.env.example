# Gemini API Key (Optional — prototype automatically runs in deterministic rubric fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# Allowed CORS Origins (comma-separated, add production frontend domain when deployed)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection
# If DATABASE_URL is left blank, ResumeFit automatically uses local SQLite (resumefit.db)
# For Supabase PostgreSQL, paste your Connection String (URI) from the Supabase Dashboard:
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# JWT Secret Key (Change this in production)
JWT_SECRET=resumefit-super-secret-jwt-key-2026-university-student-ats

# Pro Promo Codes (Comma-separated list of permanent unlock codes for students & evaluators)
PROMO_CODES=CAMPUS2026,TEACHERVIP,TEAMPRO,RESUMEFIT_PRO,STUDENTVIP
